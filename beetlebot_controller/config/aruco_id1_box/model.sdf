<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="aruco_id1_box">
    <pose>0 0 0.15 0 0 0</pose>

    <link name="box_link">
      <inertial>
        <mass>2</mass>
        <inertia>
          <ixx>0.041666667</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.056666667</iyy>
          <iyz>0</iyz>
          <izz>0.068333333</izz>
        </inertia>
      </inertial>

      <!-- Box collision -->
      <collision name="box_collision">
        <geometry>
          <box>
            <size>0.5 0.4 0.3</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>10000000.0</kp>
              <kd>1.0</kd>
              <min_depth>0.001</min_depth>
              <max_vel>0.1</max_vel>
            </ode>
          </contact>
        </surface>
      </collision>

      <!-- Box visual-->
      <visual name="box_visual">
        <pose>0 0 -0.15 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://meshes/cardboard_box.dae</uri>
            <scale>1.25931896 1.007455168 0.755591376</scale>
          </mesh>
        </geometry>
      </visual>

      <!-- ArUco marker front -->
      <visual name="vf">
        <pose>0.26 0 0 1.5708 -1.5708 1.5708</pose>
        <geometry>
          <mesh><uri>model://meshes/aruco_marker_1.dae</uri></mesh>
        </geometry>
      </visual>

      <!-- ArUco marker back -->
      <visual name="vb">
        <pose>-0.26 0 0 -1.5708 -1.5708 1.5708</pose>
        <geometry>
          <mesh><uri>model://meshes/aruco_marker_1.dae</uri></mesh>
        </geometry>
      </visual>

      <!-- ArUco marker left -->
      <visual name="vl">
        <pose>0 0.21 0 1.5708 -1.5708 3.1416</pose>
        <geometry>
          <mesh><uri>model://meshes/aruco_marker_1.dae</uri></mesh>
        </geometry>
      </visual>

      <!-- ArUco marker right -->
      <visual name="vr">
        <pose>0 -0.21 0 1.5708 -1.5708 0</pose>
        <geometry>
          <mesh><uri>model://meshes/aruco_marker_1.dae</uri></mesh>
        </geometry>
      </visual>

    </link>
  </model>
</sdf>
